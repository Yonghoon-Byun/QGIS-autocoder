# QGIS AI Auto-Coder 설정
# 이 파일을 .env 로 복사한 후 값을 입력하세요.
# 복사: .env.example → .env

# ============================================================
# Claude API
# ============================================================
# QGIS_AI_PROVIDER=Claude
# QGIS_AI_API_KEY=여기에_Claude_API키_입력
# QGIS_AI_MODEL=claude-sonnet-4-6

# ============================================================
# Gemini Vertex AI (GCP 서비스 계정 인증)
# ============================================================
# QGIS_AI_PROVIDER=Gemini (Vertex AI)
# QGIS_AI_API_KEY=여기에_GCP_프로젝트ID_입력
# QGIS_AI_MODEL=gemini-2.0-flash-001
# QGIS_AI_BASE_URL=asia-northeast3

# GCP 서비스 계정 인증 파일 경로 (Gemini 사용 시 필요)
# gcp-credentials.json 파일을 플러그인 폴더에 넣고 아래 주석 해제
# GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# ============================================================
# OpenAI
# ============================================================
# QGIS_AI_PROVIDER=OpenAI
# QGIS_AI_API_KEY=여기에_OpenAI_API키_입력
# QGIS_AI_MODEL=gpt-4o

# ============================================================
# Ollama (로컬)
# ============================================================
# QGIS_AI_PROVIDER=Ollama
# QGIS_AI_BASE_URL=http://localhost:11434
# QGIS_AI_MODEL=llama3.1:latest
